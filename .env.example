# Environment Variables — TFTS Platform (Tactical Field Intelligence Service)
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.

# ============================================================
# AUTHENTICATION
# ============================================================

# 256-bit random secret for JWT signing.
# Generate with: openssl rand -base64 32
# REQUIRED in production. If absent in development, auth is bypassed with a warning.
AUTH_SECRET=

# Session lifetime in seconds (default: 28800 = 8 hours)
SESSION_EXPIRY_SECONDS=28800

# Session cookie name (defaults to pi_session if not set)
SESSION_COOKIE_NAME=pi_session

# TOTP issuer name shown in authenticator apps (e.g. Google Authenticator)
MFA_ISSUER="TFTS — Tactical Field Intelligence Service"

# ============================================================
# DATABASE
# ============================================================

# Primary database connection string (PostgreSQL recommended for RLS support)
# Supabase example: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=

# Connection pool size (for direct connections)
DATABASE_POOL_SIZE=10

# ============================================================
# FILE STORAGE (Private — never use public buckets)
# ============================================================

# S3-compatible private storage endpoint
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET_NAME=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Signed URL expiry in seconds (default: 300 = 5 minutes)
STORAGE_SIGNED_URL_EXPIRY=300

# ============================================================
# RATE LIMITING
# ============================================================

# Redis connection URL for distributed rate limiting (optional in development)
# Example: redis://localhost:6379
REDIS_URL=

# Failed login attempts before lockout (default: 5)
AUTH_MAX_FAILED_ATTEMPTS=5

# Lockout duration in seconds (default: 900 = 15 minutes)
AUTH_LOCKOUT_DURATION_SECONDS=900

# ============================================================
# APPLICATION
# ============================================================

# Base URL of the admin application (used for CSRF and CORS validation)
ADMIN_BASE_URL=https://tfts.co.uk

# Application environment
NODE_ENV=development

# ============================================================
# AUDIT & COMPLIANCE
# ============================================================

# Retain audit logs for this many days before review (default: 2555 = 7 years)
AUDIT_RETENTION_DAYS=2555

# Default case retention period in days (default: 2555 = 7 years)
CASE_RETENTION_DEFAULT_DAYS=2555

# ============================================================
# INTEGRATIONS (FUTURE)
# ============================================================

# These are intentionally blank — no external data sharing by default.
# Each integration must be explicitly enabled and assessed before activation.

# Example future integration secrets:
# COMPANIES_HOUSE_API_KEY=
# HMRC_API_KEY=

# ============================================================
# SECURITY NOTES
# ============================================================
#
# 1. All values in this file are SERVER-SIDE ONLY.
#    Variables prefixed NEXT_PUBLIC_ are exposed to the browser.
#    NEVER prefix sensitive values with NEXT_PUBLIC_.
#
# 2. AUTH_SECRET must be a cryptographically random value of at least 32 bytes.
#    Rotating this value will invalidate all existing sessions.
#
# 3. Storage credentials must have the minimum required permissions:
#    - Read/write to the designated bucket only
#    - No public access
#    - No delete permission (immutability via S3 Object Lock preferred)
#
# 4. DATABASE_URL must connect to a user with the minimum required permissions.
#    Row Level Security (RLS) must be enabled on all sensitive tables.

# Public canonical base URL — safe to expose in browser.
# In production set this to https://tfts.co.uk
# In local dev you may leave it unset (defaults to https://tfts.co.uk in build)
NEXT_PUBLIC_SITE_URL=https://tfts.co.uk